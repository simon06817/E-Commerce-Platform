MYSQL_ROOT_PASSWORD=root123456

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

JWT_SECRET=change-me-to-a-long-random-string
ALIYUN_AI_API_KEY=
UPLOAD_DIR=./uploads
